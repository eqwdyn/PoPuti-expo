{
    "expo": {
        "name": "ПоПути",
        "slug": "poputi",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/logo.png",
        "scheme": "client",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/images/logo.png"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/logo.png",
                "backgroundImage": "./assets/images/logo.png",
                "monochromeImage": "./assets/images/logo.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.anonymous.client"
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/logo.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/logo.png",
                    "imageWidth": 76
                }
            ],
            [
                "expo-yandex-mapkit",
                {
                    "apiKey": "582975b5-bdf6-4461-8635-94ab1495d887",
                    "locale": "ru_RU",
                    "flavor": "full",
                    "version": "4.42.0",
                    "locationWhenInUsePermission": "Разрешите доступ к геолокации, чтобы показывать ваше местоположение на карте и находить ближайшие заказы."
                }
            ],
            "expo-secure-store"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}