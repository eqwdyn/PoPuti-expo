{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-native",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/assets/*": [
                "./assets/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@widgets/*": [
                "./src/widgets/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@entities/*": [
                "./src/entities/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
            "@app/*": [
                "./src/app/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}