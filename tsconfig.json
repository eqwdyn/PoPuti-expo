{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react-native",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/assets/*": [
                "./assets/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ],
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}